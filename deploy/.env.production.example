APP_NAME=Parasat
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://test.parasat-aj.kz

APP_LOCALE=kz
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- База данных: значения берутся из панели хостинга ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# На shared-хостинге file работает без настройки
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log

# Временный секрет для веб-роута /__deploy (artisan-команды через браузер, если нет SSH).
# Задать длинную случайную строку на время настройки, потом убрать эту строку.
# DEPLOY_KEY=

